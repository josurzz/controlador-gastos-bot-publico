# Copiar este archivo a ".env" y completar los valores reales.
# El archivo .env NUNCA se comparte ni se sube a ningun lado (tiene tus claves privadas).

# Token del bot de Telegram (te lo da @BotFather al crear el bot)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenAbcDefGhiJklMnoPqrStuVwx

# Que IA interpreta el texto: anthropic (default), openai, gemini u ollama
# (local, gratis). Ver README "Cambiar de proveedor de IA" para mas detalle.
# Solo hace falta completar las variables del proveedor que elijas aca abajo.
AI_PROVIDER=anthropic

# --- anthropic (console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=sk-ant-api03-TU_API_KEY_ACA
ANTHROPIC_MODEL=claude-haiku-4-5

# --- openai (platform.openai.com -> API Keys) ---
# OPENAI_API_KEY=sk-TU_API_KEY_ACA
# OPENAI_MODEL=gpt-4o-mini

# --- gemini (aistudio.google.com -> Get API Key) ---
# GEMINI_API_KEY=TU_API_KEY_ACA
# GEMINI_MODEL=gemini-2.0-flash

# --- ollama (local, sin costo - https://ollama.com, "ollama pull llama3.1") ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ID de la Google Sheet donde se van a guardar los gastos.
# Es la parte de la URL entre /d/ y /edit, ej:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEETS_ID=TU_GOOGLE_SHEETS_ID_ACA
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_TAB_NAME=Gastos

# Tamaño del modelo Whisper local: tiny, base, small, medium, large-v3
# "small" es un buen equilibrio entre velocidad y precision para audios cortos en español.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

TIMEZONE=America/Argentina/Buenos_Aires

# Dejar vacio la primera vez. Despues de mandarle /start al bot, te va a devolver
# tu user_id de Telegram: copialo aca para que el bot solo te responda a vos.
ALLOWED_TELEGRAM_USER_ID=
